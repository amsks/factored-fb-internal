\section{A failure mode at control bottlenecks}
\label{sec:failure}
%  When changing the action changes the future, does the learned successor representation capture the correct change?

Prior work has observed that methods to approximate SMs struggle on robotic manipulation tasks that require precise interactions~\citep{cetin-rlj24a,shen-arxiv26a,mohan-rlbrew26a}.
In particular, \citet{shen-arxiv26a} argue that interactions can change the active dynamics of an object and, consequently, its future reachability.
Motivated by this conditional influence, we study a strict reachability condition: one action can lead to positive reward, while the other prevents all future positive reward under the continuation policy.

% \tongle{See appendix theory rewrite}
% \aditya{Indicator function def.}

% \begin{definition}[Control bottleneck]
% \label{def:control-bottleneck}
% Fix a bounded reward $r$ and continuation policy $\pi$. Let $X\subseteq\mathcal S$ be reachable from $\mu$, and let $\mathcal E\subseteq\mathcal S\times\mathcal S$ be a set of transitions that must be crossed to reach $X$ from $\mu$, under any policy.
% A state $s$ from which $\mathcal E$ can be crossed with positive probability is a control bottleneck if some actions $a_+,a_-$ satisfy
% \[
%     \int_{\mathcal S} r(s^+) \bigl[M^\pi(s,a_+,ds^+)-M^\pi(s,a_-,ds^+)\bigr] > 0.
% \]s
% \end{definition}

\begin{definition}[Control bottleneck]
\label{def:control-bottleneck}
Fix a bounded reward $r$, a continuation policy $\pi$, and a measurable region $X$ reachable from $\mu$, with $\mu(X)=0$.
A set of transitions $\mathcal E\subseteq\mathcal S\times\mathcal S$ is necessary for reaching $X$ from $\mu$ if, under every policy
with $s_0\sim\mu$ and for every $t\geq1$,
\[
    \Pr\!\left( s_t\in X \;\text{and}\; (s_k,s_{k+1})\notin\mathcal E \text{ for all }k=0,\ldots,t-1 \right)=0.
\]
For such a necessary set $\mathcal E$, a state $s$ is a control bottleneck if $P(\{s':(s,s')\in\mathcal E\}\mid s,a)>0$ for some action $a$, and it admits actions $a_+,a_-$ satisfying
\[
    \int_{\mathcal S}r(s^+) \bigl[M^\pi(s,a_+,ds^+)-M^\pi(s,a_-,ds^+)\bigr]>0.
\]
\end{definition}


% \cref{def:bottleneck} provides a strict idealization of the bottleneck, where the wrong action removes all future reward. 
% Real interactions are softer, for example, a dropped cube can be re-grasped (\cref{fig:carry}, t = 43).
% However, they share the same structure in relaxed form: the competing actions induce large differences in future occupancy that are supported on few transitions. 
% Because $r$ is nonnegative, $a_+$ can lead to rewarded states, whereas $a_-$ prevents all future visits to rewarded states when subsequent actions follow $\pi$.
% By \eqref{eq:sm-value}, the true action values therefore satisfy $Q_r^\pi(s,a_+)>Q_r^\pi(s,a_-)=0$. 
% For control, an SM approximation must preserve this action ordering.

For the two results below, fix $0<\gamma<1$ and consider fits to exact SMs on finite MDPs.
Within each fitting problem, the continuation policy and its index $z$ are fixed, $\rho$ is uniform over states, and all state-action
pairs are weighted equally. 
The forward and backward values are unrestricted vectors in $\mathbb R^d$.

% \begin{lemma}[Linear fitting can lose bottleneck action distinctions]
%     \label{lem:linear-action-difference}
%     For every feature dimension $d\geq1$ and $\varepsilon>0$, there exist a finite MDP, a policy $\pi$, a bounded nonnegative state reward $r$, and a state $s\in\mathcal S_{\mathrm{cb}}(\pi,r,\varepsilon)$ with actions $a_+,a_-$ satisfying $Q_r^\pi(s,a_+)-Q_r^\pi(s,a_-) > 0$.
%     Yet, every global minimizer of the squared error between FB's predicted and exact successor densities assigns identical predictions to $a_+,a_-$:
%     \begin{equation}
%         \bigl(F_\theta(s,a_+,z)-F_\theta(s,a_-,z)\bigr)^\top B_\theta(s^+) =0, \qquad \forall s^+\in\mathcal S.
%         \label{eq:projected-action-difference}
%     \end{equation}
% \end{lemma}

\begin{lemma}[Loss of a bottleneck distinction]
\label{lem:bottleneck-loss}
Fix $B$, and let $F^*$ independently minimize the $rho$-weighted squared error against the exact SM. 
For the actions $a_+,a_-$ at a control bottleneck (\cref{def:control-bottleneck}), the fitted densities $F^*(s,a_+,z)^\top B(\cdot)$ and $F^*(s,a_-,z)^\top B(\cdot)$ coincide $rho$-everywhere if and only if
\[
    \int_{\mathcal S} B(s^+)\,M^\pi(s,a_+,ds^+) = \int_{\mathcal S} B(s^+)\,M^\pi(s,a_-,ds^+).
\]
Whenever this holds, the fitted values obtained through
\eqref{eq:sm-value} satisfy
\[
    \widehat Q_r^\pi(s,a_+)=\widehat Q_r^\pi(s,a_-), \qquad Q_r^\pi(s,a_+)>Q_r^\pi(s,a_-).
\]
\end{lemma}



The proof, given in \cref{app:bottleneck-proof}, constructs for each feature dimension $d$ an MDP containing $d-1$ auxiliary components unrelated to the bottleneck; because they contribute more state--action pairs, the squared objective spends all its capacity on them.

