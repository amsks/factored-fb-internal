\section{Theoretical Analysis}
\label{app:dfb-theory}
\label{app:theory}
\label{app:bottleneck-proof}

\subsection{Proof of Lemma~\ref{lem:bottleneck-loss}}

\paragraph{Setup.}
Fix $z$ and write $\pi=\pi_z$. Let $s,a_+,a_-$ satisfy \cref{def:control-bottleneck} for a bounded measurable reward $r$.
Hold $B$ fixed and assume, for $a\in\{a_+,a_-\}$,
\[
    M^\pi(s,a,ds^+) =g^\pi(s,a,s^+)\,\rho(ds^+), \qquad g^\pi(s,a,\cdot),B_1,\ldots,B_d\in L^2(\rho).
\]
The forward vectors minimize their squared errors independently:
\[
    F^*(s,a,z) \in\operatorname*{arg\,min}_{f\in\mathbb R^d} \int_{\mathcal S} \bigl[g^\pi(s,a,s^+)-f^\top B(s^+)\bigr]^2 \,\rho(ds^+).
\]
Define the fitted values by
\[
    \widehat Q_r^\pi(s,a) :=\frac{1}{1-\gamma} \int_{\mathcal S}r(s^+)\, F^*(s,a,z)^\top B(s^+)\,\rho(ds^+).
\]

\begin{proof}
\paragraph{Step 1: Characterize the optimum.}
Differentiating each squared-error objective gives
\[
    CF^*(s,a,z) =\int_{\mathcal S}B(s^+)\,M^\pi(s,a,ds^+), \qquad C:=\int_{\mathcal S}B(s^+)B(s^+)^\top\,\rho(ds^+).
\]
These equations hold for every minimizer, including when $C$ is singular.

\paragraph{Step 2: Prove the equivalence.}
Let $v:=F^*(s,a_+,z)-F^*(s,a_-,z)$. Subtracting the optimality equations yields
\[
    Cv =\int_{\mathcal S}B(s^+) \bigl[M^\pi(s,a_+,ds^+)-M^\pi(s,a_-,ds^+)\bigr].
\]
Thus the feature expectations agree if and only if $Cv=0$.

In the forward direction,
\[
    Cv=0 \quad\Longrightarrow\quad \int_{\mathcal S}\bigl[v^\top B(s^+)\bigr]^2\,\rho(ds^+) =v^\top Cv=0 \quad\Longrightarrow\quad v^\top B(\cdot)=0 \quad\rho\text{-almost everywhere}.
\]
Conversely,
\[
    v^\top B(\cdot)=0 \quad\rho\text{-almost everywhere} \quad\Longrightarrow\quad Cv=\int_{\mathcal S}B(s^+)\, \bigl[v^\top B(s^+)\bigr]\,\rho(ds^+)=0.
\]
Hence the fitted densities coincide $\rho$-almost everywhere if and only if the feature expectations agree.

\paragraph{Step 3: Compare the action values.}
Under these equivalent conditions,
\[
    \widehat Q_r^\pi(s,a_+)-\widehat Q_r^\pi(s,a_-) =\frac{1}{1-\gamma} \int_{\mathcal S}r(s^+)\, v^\top B(s^+)\,\rho(ds^+) =0.
\]
However, \cref{def:control-bottleneck} and \eqref{eq:sm-value} give
\[
    Q_r^\pi(s,a_+)-Q_r^\pi(s,a_-) =\frac{1}{1-\gamma} \int_{\mathcal S}r(s^+) \bigl[M^\pi(s,a_+,ds^+)-M^\pi(s,a_-,ds^+)\bigr] >0.
\]
Thus the fitted values coincide despite a strictly positive true action-value gap.
\end{proof}

\subsection{Proof of Proposition~\ref{prop:bottleneck-preservation}}

\paragraph{Setup.}
Fix $\pi=\pi_z$ and the bottleneck actions $a_+,a_-$.
Define the fitted values by
\[
    \widehat Q_r^\pi(s,a) :=\frac{1}{1-\gamma} \int_{\mathcal S}r(s^+)\, \widehat M_\theta(s,a,z,ds^+).
\]

\begin{proof}
\paragraph{Step 1: Bound the value error.}
Write
\[
    \Delta:=Q_r^\pi(s,a_+)-Q_r^\pi(s,a_-), \qquad R:=\sup_{\mathcal S}r-\inf_{\mathcal S}r.
\]
By \cref{def:control-bottleneck} and \eqref{eq:sm-value},
$\Delta>0$; boundedness of $r$ then gives $0<R<\infty$.

Both the true and fitted SMs are probability measures.
The bounded-reward expectation bound and Pinsker's inequality give
\[
    \left|\widehat Q_r^\pi(s,a)-Q_r^\pi(s,a)\right| \leq \frac{R}{1-\gamma} \sqrt{ \frac12 D_{\mathrm{KL}}\!\left( M^\pi(s,a,\cdot) \,\middle\|\, \widehat M_\theta(s,a,z,\cdot)
        \right)
    }.
\]

\paragraph{Step 2: Choose a sufficient accuracy threshold.}
Set
\[
    \varepsilon
    :=\frac{(1-\gamma)^2\Delta^2}{2R^2}.
\]
If the KL divergence is below $\varepsilon$ for both actions, then
\[
    \left|\widehat Q_r^\pi(s,a)-Q_r^\pi(s,a)\right|
    <
    \frac{R}{1-\gamma}\sqrt{\frac{\varepsilon}{2}}
    =\frac{\Delta}{2},
    \qquad a\in\{a_+,a_-\}.
\]

\paragraph{Step 3: Preserve the action ordering.}
The fitted gap therefore satisfies
\begin{align*}
    \widehat Q_r^\pi(s,a_+)-\widehat Q_r^\pi(s,a_-)
    &\geq
    \Delta
    -\left|\widehat Q_r^\pi(s,a_+)-Q_r^\pi(s,a_+)\right| \\
    &\quad
    -\left|\widehat Q_r^\pi(s,a_-)-Q_r^\pi(s,a_-)\right| \\
    &>
    \Delta-\frac{\Delta}{2}-\frac{\Delta}{2}
    =0.
\end{align*}
\end{proof}


\subsection{Convergence under exact fitting}

We adapt the convergence argument of
TD InfoNCE~\citep[Appendix~A]{zheng-iclr24a}
and use a KL bound to connect convergence to
\cref{prop:bottleneck-preservation}.
All expectations and normalizing constants are evaluated exactly.

\paragraph{Setup.}
Assume finite state and action spaces, positive mass under $\rho$
on every state, and a fixed continuation policy $\pi=\pi_z$.
Write
\[
    \widehat M_k(s,a,\cdot)
    :=\widehat M_{\theta_k}(s,a,z,\cdot),
\]
and initialize $\widehat M_0$ with positive mass on every state
for every state--action pair.

At iteration $k$, define the Bellman targets
\[
    T_k(s,a,\cdot)
    :=(1-\gamma)P(\cdot\mid s,a)
    +\gamma
    \mathbb E_{\substack{
        s'\sim P(\cdot\mid s,a)\\
        a'\sim\pi(\cdot\mid s')
    }}
    \left[\widehat M_k(s',a',\cdot)\right].
\]
Assume that, at every iteration, these targets are jointly
representable by \name{} at the chosen feature dimension.
Each categorical fitting objective is minimized globally,
with targets held fixed and positive fitting weight on every
state--action pair.

Then
\[
    \max_{s,a}
    D_{\mathrm{KL}}\!\left(
        M^\pi(s,a,\cdot)
        \,\middle\|\,
        \widehat M_k(s,a,\cdot)
    \right)
    \longrightarrow 0,
\]
and the bottleneck action ordering is preserved at every
sufficiently large iteration.

\begin{proof}
\paragraph{Step 1: Recover the Bellman target.}
For each state--action pair, the categorical loss satisfies
\begin{align*}
    &-\int_{\mathcal S}
    \log h_\theta(s,a,z,s^+)\,T_k(s,a,ds^+) \\
    &\qquad=
    D_{\mathrm{KL}}\!\left(
        T_k(s,a,\cdot)
        \,\middle\|\,
        \widehat M_\theta(s,a,z,\cdot)
    \right)
    +\text{constant},
\end{align*}
where the constant is independent of $\theta$.
Joint realizability, positive fitting weights, and global
minimization imply
\[
    \widehat M_{k+1}(s,a,\cdot)=T_k(s,a,\cdot)
    \qquad\text{for every }(s,a).
\]

\paragraph{Step 2: Establish KL contraction.}
Define
\[
    K_k
    :=\max_{s,a}
    D_{\mathrm{KL}}\!\left(
        M^\pi(s,a,\cdot)
        \,\middle\|\,
        \widehat M_k(s,a,\cdot)
    \right).
\]
The true SM and the fitted update share the same immediate-transition
component. By \eqref{eq:sm-bellman} and joint convexity of KL,
\begin{align*}
    &D_{\mathrm{KL}}\!\left(
        M^\pi(s,a,\cdot)
        \,\middle\|\,
        \widehat M_{k+1}(s,a,\cdot)
    \right) \\
    &\quad\leq
    \gamma
    \mathbb E_{\substack{
        s'\sim P(\cdot\mid s,a)\\
        a'\sim\pi(\cdot\mid s')
    }}
    \left[
        D_{\mathrm{KL}}\!\left(
            M^\pi(s',a',\cdot)
            \,\middle\|\,
            \widehat M_k(s',a',\cdot)
        \right)
    \right] \\
    &\quad\leq\gamma K_k.
\end{align*}
Taking the maximum over $(s,a)$ gives
\[
    K_{k+1}\leq\gamma K_k.
\]

\paragraph{Step 3: Reach the preservation threshold.}
Positive initialization and finite state and action spaces
ensure $K_0<\infty$. Hence
\[
    K_k\leq\gamma^kK_0\longrightarrow0.
\]
For the threshold $\varepsilon>0$ in
\cref{prop:bottleneck-preservation}, there is therefore an
iteration $k_0$ such that
\[
    D_{\mathrm{KL}}\!\left(
        M^\pi(s,a,\cdot)
        \,\middle\|\,
        \widehat M_k(s,a,\cdot)
    \right)
    \leq K_k<\varepsilon,
    \qquad
    a\in\{a_+,a_-\},\quad k\geq k_0.
\]
The proposition then gives the claimed action ordering.
\end{proof}