\section{A failure mode at control bottlenecks}
\label{sec:failure}
\label{sec:exp-failure} % alias used by the experiments section
%  When changing the action changes the future, does the learned successor representation capture the correct change?

Prior work has observed that methods for approximating SMs struggle on robotic manipulation tasks requiring precise interactions~\citep{cetin-rlj24a,shen-arxiv26a,mohan-rlbrew26a}. As \citet{shen-arxiv26a} argue, such interactions can change an object's dynamics and, consequently, its future reachability. 
An SM approximation must capture these consequences to distinguish actions that enable valuable outcomes.
We isolate this requirement through \emph{control bottlenecks}: necessary passages to valuable regions where the choice of action matters for return.

% Set of A+ ,A- 
% somehting is a control bottleneck iff 
% a single transition, downstream value for the set a+ changes siginificatnly more than a-
% if sets a+ and a- are complete, then we have to seleect a+ at the control bottleneck 
% We cannot go around it
% there exists s such that V(X) is high, s is necessary to reach X, and Q(s, a+) >> Q(s,a-)
\begin{definition}[Control bottleneck]
\label{def:control-bottleneck}
% reaching a valuable region requires crossing an unavoidable passage, and at every entry state, the best action that can cross it is substantially more valuable than any action that cannot.
Fix an initial distribution $\mu$, a bounded reward $r$, a continuation policy $\pi$, and thresholds $\Delta>0$ and $v_{\mathrm{high}}$.
Let $X\subseteq\{x:V_r^\pi(x)\ge v_{\mathrm{high}}\}$ be reachable from $\mu$, with $\mu(X)=0$.
A measurable passage $\xi\subseteq(\mathcal S\setminus X)\times\mathcal S$ is \emph{necessary} for $X$ if, under every policy, trajectories initialized from $\mu$ that reach $X$ must first cross $\xi$, almost surely.
For $\xi_s:=\{s':(s,s')\in\xi\}$, define
\[
    \mathcal A_+(s):=\{a\in\mathcal A(s):P(\xi_s\mid s,a)>0\}, \qquad \mathcal A_-(s):=\mathcal A(s)\setminus\mathcal A_+(s).
\]
A necessary passage $\xi$ is a \emph{$\Delta$-control bottleneck} if every state $s$ with $\mathcal A_+(s)\neq\varnothing$ also satisfies $\mathcal A_-(s)\neq\varnothing$ and
\[
    \sup_{a\in\mathcal A_+(s)}Q_r^\pi(s,a) - \sup_{a\in\mathcal A_-(s)}Q_r^\pi(s,a)
    \ge\Delta.
\]
\end{definition}

Although every successful trajectory must cross the passage, the fitted SMs must still distinguish which actions make crossing valuable.
For fixed backward features $B$, least-squares fitting retains this distinction only insofar as it appears in the expected features of the two successor distributions. When these expectations coincide, even optimal fitting assigns the actions identical values despite their different returns, as \cref{lem:bottleneck-loss} establishes.

% Define Q hat
% There is a disconnectbeween integrals and Q values -- how does the fitting produce equality of integrals
% How are the fitted densities
% When  we learn M, it will produce approximation error that produces this equatlit. if this equality exits, then approx Q values are equal, even though the real ones are different
% FB trianing is going to produce these equalites when trainin on the control bottleneck

\begin{lemma}[Loss of a bottleneck action distinction]
\label{lem:linear-action-difference}
\label{lem:bottleneck-loss}
Fix $\pi=\pi_z$ and $B\in L^2(\rho;\mathbb R^d)$.
At a bottleneck entry state $s$, choose $a_+\in\mathcal A_+(s)$ and $a_-\in\mathcal A_-(s)$ with $Q_r^\pi(s,a_+)>Q_r^\pi(s,a_-)$.
For each $a\in\{a_+,a_-\}$, let $M_a:=M^\pi(s,a,\cdot)$ have density $m_a\in L^2(\rho)$, and define its optimal linear fit by
\[
    f_a^*\in\arg\min_{f\in\mathbb R^d} \|m_a-f^\top B\|_{L^2(\rho)}^2, \qquad \widehat m_a:=(f_a^*)^\top B.
\]
Define $\widehat Q_r^\pi(s,a):=(1-\gamma)^{-1} \int_{\mathcal S}r(s^+)\widehat m_a(s^+)\rho(ds^+)$. Then
\(
    \mathbb E_{M_{a_+}}[B]=\mathbb E_{M_{a_-}}[B] \quad\Longleftrightarrow\quad \widehat m_{a_+}=\widehat m_{a_-}\;
    \quad\Longrightarrow\quad
    \widehat Q_r^\pi(s,a_+)=\widehat Q_r^\pi(s,a_-).
\)
\end{lemma}

\paragraph{Proof sketch.} Optimal linear fitting projects each successor density onto the span of the backward features. The projections coincide exactly when the density difference
is orthogonal to every feature, equivalently when the feature expectations agree; integrating the fitted densities against $r$ then gives identical values (\cref{app:bottleneck-proof}).

