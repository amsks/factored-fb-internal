\section{\name{}: Learning Successor Measures as Distributions}
\label{sec}


\begin{algorithm}[t]
\caption{\name{} training and zero-shot control}
\label{alg:density-fb}
    \begin{algorithmic}[1]
    \Require Offline dataset $\mathcal D$, successor networks $(F_\theta,B_\theta)$, target networks $(\bar F,\bar B)$, actor $\pi_\omega$
    
    \For{each training step}
        \State Sample transitions $\{(s_i,a_i,s_i',\mathrm{terminal}_i)\}_{i=1}^{n}$ from $\mathcal D$
        \State Sample task vectors $\{z_i\}_{i=1}^{n}$ using the same task distribution as FB
        \For{$i=1,\ldots,n$}
            \State Compute normalized successor probabilities
            \( p_{ij} \gets \softmax_j f_\theta(s_i,a_i,z_i,s_j') \)
            \State Sample $a_i' \sim \pi_\omega(\cdot\mid s_i',z_i)$
            \State Compute target-network probabilities
            \( \bar p_{ij}' \gets \softmax_j \bar f(s_i',a_i',z_i,s_j') \)
            \State Form the Bellman target
            \( t_{ij} \gets \sg\!\left[ (1-d_i)\ind{j=i} + d_i\bar p_{ij}' \right] \)
        \EndFor
        \State Update $(F_\theta,B_\theta)$ using
        \( \mathcal L_{\mathrm{DFB}} = -\frac{1}{n} \sum_{i,j} t_{ij}\log p_{ij} \)
        \State Compute actor values
        \( \hat q_\theta(s_i,a,z_i) = \sum_j p_j(s_i,a,z_i)\, B_\theta(s_j')^\top z_i \)
        \State Update $\pi_\omega$ using Equation~\eqref{eq:density-actor-loss}, with $(F_\theta,B_\theta)$ fixed
        \State Update target networks $(\bar F,\bar B)$
    \EndFor
    \Statex
    \Statex \textbf{Zero-shot control for a downstream reward $r$}
    \State Evaluate $r$ on states sampled from the offline dataset
    \State Infer the task vector $z_r$ using the reward encoder in Appendix~\ref{app:reward-inference}
    \State Execute the frozen policy $\pi_\omega(\cdot\mid s,z_r)$ without further training
    \end{algorithmic}
\end{algorithm}

