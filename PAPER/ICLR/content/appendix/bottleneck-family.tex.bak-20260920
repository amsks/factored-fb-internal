    \label{tab:family-rank}
    \begin{tabular}{lrrrrrr}
    \toprule
    Arm & P1 & P2 & P3 & P4 & P5 & median \\
    \midrule
    FB                             & 5 & 8 & 6 & 7 & 7 & 7 \\
