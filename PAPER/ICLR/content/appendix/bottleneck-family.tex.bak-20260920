    Softmax + squared error        & 2 & 2 & 3 & 3 & 2 & 2 \\
    \name{}                        & 3 & 2 & 4 & 5 & 3 & 3 \\
    \name{}, linear readout        & - & 2 & - & 3 & - & - \\
    \name{}, soft immediate target & - & - & - & - & - & - \\
    \bottomrule
    \end{tabular}
\end{table}

