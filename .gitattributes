# Normalize line endings to LF in the repo (avoids CRLF push/CI/bash issues on Windows).
* text=auto eol=lf

# Shell scripts must stay LF — CRLF breaks shebangs on Linux runners.
*.sh text eol=lf

# Windows-only scripts may keep CRLF if we add any later.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
