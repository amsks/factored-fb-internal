domain: cube-single-play-v0
obs_type: pixels
data_path: /dev/shm/factored-fb/datasets
n_transitions: null
load_n_episodes: 1000
num_train_steps: 50000
batch_size: 256
eval_every: 50000
log_every: 1000
save_every: 200000
seed: 0
device: cuda
eval_n_episodes: 10
