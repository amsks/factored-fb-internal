agent: fb_flowbc
z_dim: 50
L_dim: 256
actor_encode_obs: false
discount: 0.99
lr_f: 0.0001
lr_b: 0.0001
lr_actor: 0.0001
weight_decay: 0.0
clip_grad_norm: 0.0
ortho_coef: 1.0
train_goal_ratio: 0.5
fb_pessimism_penalty: 0.0
actor_pessimism_penalty: 0.0
